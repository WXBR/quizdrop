{
  "name": "quizdrop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Drop in lecture slides, get a live multiplayer quiz your class can join from their phones.",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"node --env-file-if-exists=.env --watch server/dev.js\" \"vite\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/dev.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@upstash/redis": "^1.41.0",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
